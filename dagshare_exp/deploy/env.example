# Copy to dagshare_exp/deploy/.env (gitignored) and fill in. Shell env vars override these.
CIVO_TOKEN=
CIVO_REGION=LON1
CLUSTER_NAME=dagshare
# Empty = auto-pick the smallest A100/L40S Kubernetes size from `civo sizes ls`.
GPU_SIZE=
HF_TOKEN=
IMAGE=ghcr.io/azkanab/vllm-dagshare:dagshare
NAMESPACE=dagshare-$USER
MODEL=meta-llama/Llama-3.1-8B-Instruct
# Kube context to use; defaults to CLUSTER_NAME (what `civo kubernetes config --save` creates).
KUBE_CONTEXT=
# Only if the GHCR package is private: a GitHub PAT with read:packages.
GHCR_USER=
GHCR_TOKEN=
# Per-run resources (Guaranteed QoS, integer CPUs). A100 node: 8 vCPU; L40S node: 12 vCPU.
SERVER_CPUS=4
SERVER_MEM=32Gi
LOADGEN_CPUS=2
LOADGEN_MEM=4Gi
# Set only if `kubectl describe node` shows a taint on the GPU node.
GPU_TOLERATION_KEY=
