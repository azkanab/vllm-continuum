apiVersion: batch/v1
kind: Job
metadata:
  name: dagshare-prefetch
  namespace: ${NAMESPACE}
  labels:
    app.kubernetes.io/part-of: dagshare
    app.kubernetes.io/component: prefetch
spec:
  backoffLimit: 1
  activeDeadlineSeconds: 7200
  ttlSecondsAfterFinished: 86400
  template:
    metadata:
      labels:
        app.kubernetes.io/part-of: dagshare
        app.kubernetes.io/component: prefetch
    spec:
      restartPolicy: Never
      automountServiceAccountToken: false
      enableServiceLinks: false
      imagePullSecrets:
        - name: ghcr-pull
${TOLERATIONS_BLOCK}
      volumes:
        - name: hf-cache
          persistentVolumeClaim:
            claimName: dagshare-hf-cache
      containers:
        - name: prefetch
          image: ${IMAGE}
          args: [prefetch]
          env:
            - {name: MODEL, value: "${MODEL}"}
            - name: HF_TOKEN
              valueFrom:
                secretKeyRef: {name: hf-token, key: HF_TOKEN, optional: true}
          resources:
            requests: {cpu: "2", memory: 4Gi}
            limits: {cpu: "2", memory: 4Gi}
          volumeMounts:
            - {name: hf-cache, mountPath: /root/.cache/huggingface}
